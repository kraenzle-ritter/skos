{
    "name": "kraenzle-ritter/skos",
    "description": "SKOS vocabularies in PHP: concepts and concept schemes as plain value objects, written to Turtle, RDF/XML and N-Triples with EasyRdf. Labels per language, notations, notes, broader/narrower/related with inverses completed, mapping properties, top concepts and subtrees. Framework-agnostic; consumed by Anton.",
    "type": "library",
    "license": "MIT",
    "keywords": ["skos", "thesaurus", "vocabulary", "rdf", "turtle", "linked-data"],
    "authors": [
        {
            "name": "Andreas Kränzle",
            "email": "kraenzle@k-r.ch"
        }
    ],
    "require": {
        "php": "^8.3",
        "sweetrdf/easyrdf": "^1.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "KraenzleRitter\\Skos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KraenzleRitter\\Skos\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
